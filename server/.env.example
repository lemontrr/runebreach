# Required — server refuses to start if any of these are absent
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/runebreach
JWT_SECRET=change-me-min-32-chars-random-secret
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Runebreach
WEBAUTHN_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional tuning
LOG_LEVEL=info
MAZE_WIDTH=20
MAZE_HEIGHT=20
ITEM_COUNT=10
MONSTER_COUNT=6
# TODO: TBD - define session inactivity timeout before production
SESSION_TIMEOUT_HOURS=24
